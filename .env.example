# ──────────────────────────────────────────────────────────────
# Radio station configuration
# Copy this file to `.env.local` and fill in your own values.
# All variables are exposed to the browser (NEXT_PUBLIC_ prefix).
# ──────────────────────────────────────────────────────────────

# The live stream URL from your Icecast or AzuraCast server.
# Example: https://your-azuracast.example.com/radio/8000/radio.mp3
NEXT_PUBLIC_STREAM_URL=https://ice1.somafm.com/groovesalad-128-mp3

# Optional: AzuraCast "Now Playing" JSON API endpoint for live metadata.
# Example: https://your-azuracast.example.com/api/nowplaying/1
NEXT_PUBLIC_NOWPLAYING_URL=

# Station branding
NEXT_PUBLIC_STATION_NAME=PH Radio
NEXT_PUBLIC_STATION_TAGLINE=Your Philippine stations, live
NEXT_PUBLIC_STATION_DESCRIPTION=PH Radio brings together the best Philippine radio stations in one place. Tune in to OPM, news, and talk from across the islands, streaming live 24/7.

# Social links (optional — leave blank to hide)
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com
